{
  "expo": {
    "name": "Tail Me",
    "slug": "tailme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#070A0F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tailme.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070A0F"
      },
      "package": "com.tailme.app",
      "versionCode": 1
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#7C3AED",
      "iosDisplayInForeground": true
    }
  }
}
